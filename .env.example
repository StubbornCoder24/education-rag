# 运行模式：demo 离线演示（不调用模型），live 调用真实模型
APP_MODE=demo
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 独立运行数据目录；demo 与 live 的索引隔离，切换后需要重新初始化资料
# APP_DATA=./runtime_live
# 写操作访问口令；设置后页面右上角"访问口令"要填同一个值，脚本请求带 X-API-Key
# APP_TOKEN=
# 本地向量/重排模型目录；目录不存在或未安装 sentence-transformers 时自动退回哈希向量
# EMBEDDING_MODEL_PATH=./models/bge-base-zh-v1.5
# RERANKER_MODEL_PATH=./models/bge-reranker-base
# 向量库：sqlite（默认）或 milvus；milvus 需要同时给出地址与集合名
# VECTOR_STORE=sqlite
# MILVUS_URI=http://standalone:19530
# MILVUS_COLLECTION=education_rag_demo_1024
# docker compose 发布到宿主机的端口
# RAG_HOST_PORT=8001
